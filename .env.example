# Neon backend (optional — the app runs fully offline without it).
# Both URLs are public: the Data API validates the session JWT the client
# attaches, and RLS scopes rows per user. Pull them with `neon env pull`,
# then copy the two values into these VITE_-prefixed vars. Do NOT prefix
# DATABASE_URL — that would bake a Postgres credential into the bundle.
VITE_NEON_AUTH_URL=https://your-auth-endpoint.neonauth.example/neondb/auth
VITE_NEON_DATA_API_URL=https://your-data-api-endpoint.example/rest/v1